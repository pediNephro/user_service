pipeline {
    agent any

    environment {
        DOCKER_HUB_REPO = 'azizos07/user-service'
        SERVICE_NAME = 'user-service'
        NAMESPACE = 'pedinephro'
        SONAR_HOST = 'http://localhost:9000'
        SONAR_TOKEN = credentials('sonar-token')
    }

    stages {
        stage('Setup kubeconfig') {
            steps {
                sh '''
                    export KUBECONFIG=/var/lib/jenkins/kubeconfig
                    kubectl get nodes
                '''
            }
        }
        stage('Checkout K8s') {
            steps {
                git url: 'https://github.com/pediNephro/kubernetes-config.git'
            }
        }

        stage('Sonar Quality Gate') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        curl -u ${SONAR_TOKEN}: \
                        "${SONAR_HOST}/api/qualitygates/project_status?projectKey=${SERVICE_NAME}"
                    '''
                }
            }
        }

        stage('Verify Image') {
            steps {
                sh '''
                    docker pull ${DOCKER_HUB_REPO}:latest
                '''
            }
        }

       stage('Deploy Infrastructure') {
            steps {
                sh '''
                    # Apply foundational resources in order (only if changed)
                    kubectl apply -f 00-namespace.yaml
                    kubectl apply -f 01-secrets.yaml
                    kubectl apply -f 02-configmap.yaml
                    kubectl apply -f 03-mysql.yaml
                    kubectl apply -f 04-eureka.yaml
                    kubectl apply -f 05-gateway.yaml
                    kubectl apply -f 06-keycloak.yaml
                    kubectl apply -f 12-ingress.yaml
                '''
            }
        }

        stage('Deploy User Service') {
            steps {
                sh '''
                    kubectl apply -f 07-user-service.yaml -n ${NAMESPACE}

                    kubectl set image deployment/${SERVICE_NAME} \
                        ${SERVICE_NAME}=${DOCKER_HUB_REPO}:${BUILD_NUMBER} \
                        -n ${NAMESPACE}
                '''
            }
        }
        

        stage('Verify Deployment') {
            steps {
                    sh '''
                        kubectl get pods -n ${NAMESPACE}
                        kubectl get svc -n ${NAMESPACE}
                        kubectl rollout status deployment/${SERVICE_NAME} -n ${NAMESPACE} || true
                    '''
                }
            }
        
    }
}
