pipeline {
    agent any

    environment {
        DOCKER_HUB_REPO = 'azizos07/user-service'
        SERVICE_NAME = 'user-service'
        NAMESPACE = 'pedinephro'
        SONAR_HOST = 'http://localhost:9000'
        SONAR_TOKEN = credentials('sonar-token')
    }

    stages {

        stage('Checkout K8s') {
            steps {
                git url: 'https://github.com/votre-org/pidev-k8s.git'
            }
        }

        stage('Sonar Quality Gate') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        curl -u ${SONAR_TOKEN}: \
                        "${SONAR_HOST}/api/qualitygates/project_status?projectKey=${SERVICE_NAME}"
                    '''
                }
            }
        }

        stage('Verify Image') {
            steps {
                sh '''
                    docker pull ${DOCKER_HUB_REPO}:latest
                '''
            }
        }

        stage('Deploy Kubernetes') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig-credentials', variable: 'KUBECONFIG')]) {
                    sh '''
                        kubectl create namespace ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -

                        kubectl apply -f k8s/ -n ${NAMESPACE}

                        kubectl set image deployment/${SERVICE_NAME} \
                        ${SERVICE_NAME}=${DOCKER_HUB_REPO}:latest \
                        -n ${NAMESPACE} || true
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig-credentials', variable: 'KUBECONFIG')]) {
                    sh '''
                        kubectl get pods -n ${NAMESPACE}
                        kubectl get svc -n ${NAMESPACE}
                        kubectl rollout status deployment/${SERVICE_NAME} -n ${NAMESPACE} || true
                    '''
                }
            }
        }
    }
}
